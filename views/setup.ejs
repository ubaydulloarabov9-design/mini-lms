<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>O'qituvchi hisobini yaratish</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5" style="max-width:480px;">
  <h3 class="mb-4">O'qituvchi hisobini yaratish</h3>
  <p class="text-muted small">Bu sahifa faqat dastlabki sozlash uchun ishlatiladi.</p>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form method="POST" action="/setup-teacher">
    <label class="form-label">O'qituvchi ismi</label>
    <input type="text" name="full_name" class="form-control mb-3" required>

    <label class="form-label">Email (login)</label>
    <input type="email" name="email" class="form-control mb-3" required>

    <label class="form-label">Parol</label>
    <div class="position-relative mb-3">
      <input type="password" name="password" id="setup_password" class="form-control pe-5" required>
      <button type="button" class="password-toggle-btn btn btn-sm position-absolute top-50 end-0 translate-middle-y me-1 p-1 border-0 bg-transparent text-secondary" onclick="togglePassword('setup_password', this)" tabindex="-1"></button>
    </div>

    <button class="btn btn-primary w-100">Yaratish</button>
  </form>
</div>
<script src="/js/main.js"></script>
</body>
</html>
