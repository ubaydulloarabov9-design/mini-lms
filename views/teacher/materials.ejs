<%- include('../partials/header') %>
<h3 class="mb-4">Mavzularni boshqarish</h3>

<div class="content-columns">
  <div class="content-list">
    <% if (materials.length === 0) { %>
      <p class="text-muted">Hali mavzu qo'shilmagan.</p>
    <% } %>
    <% materials.forEach(m => { %>
    <div class="card mb-2">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h5><%= m.title %></h5>
          <p class="mb-1"><%= m.description %></p>
          <% if (m.file_path) { %><a href="<%= m.file_path %>" target="_blank">📎 Faylni ko'rish</a><% } %>
        </div>
        <div class="d-flex flex-column gap-2">
          <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editMaterialModal<%= m.id %>">Tahrirlash</button>
          <form method="POST" action="/teacher/materials/<%= m.id %>/delete" onsubmit="return confirm('O\'chirilsinmi?')">
            <button class="btn btn-danger btn-sm w-100">O'chirish</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="content-form">
    <form method="POST" action="/teacher/materials" enctype="multipart/form-data" class="card p-3">
      <h5>Yangi mavzu qo'shish</h5>
      <input type="text" name="title" class="form-control mb-2" placeholder="Mavzu nomi" required>
      <textarea name="description" class="form-control mb-2" placeholder="Tavsif / ma'ruza matni" rows="4"></textarea>
      <input type="file" name="file" class="form-control mb-2">
      <button class="btn btn-primary w-100">Qo'shish</button>
    </form>
  </div>
</div>

<!-- Tahrirlash modallari - ro'yxatdan tashqarida, alohida joylashtirildi -->
<% materials.forEach(m => { %>
<div class="modal fade" id="editMaterialModal<%= m.id %>" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/teacher/materials/<%= m.id %>/update" enctype="multipart/form-data" class="modal-content">
      <div class="modal-header"><h5>Mavzuni tahrirlash</h5></div>
      <div class="modal-body">
        <label class="form-label">Mavzu nomi</label>
        <input type="text" name="title" class="form-control mb-2" value="<%= m.title %>" required>

        <label class="form-label">Tavsif / ma'ruza matni</label>
        <textarea name="description" class="form-control mb-2" rows="4"><%= m.description %></textarea>

        <label class="form-label">Fayl</label>
        <% if (m.file_path) { %>
          <div class="mb-2"><a href="<%= m.file_path %>" target="_blank">📎 Joriy fayl</a></div>
        <% } %>
        <input type="file" name="file" class="form-control">
        <div class="form-text">Yangi fayl tanlasangiz, eskisi almashtiriladi. Bo'sh qoldirsangiz, joriy fayl saqlanib qoladi.</div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Saqlash</button></div>
    </form>
  </div>
</div>
<% }) %>

<%- include('../partials/footer') %>
