<%- include('../partials/header') %>
<h3 class="mb-4">Mavzularni boshqarish</h3>

<div class="content-columns">
  <div class="content-list">
    <% if (materials.length === 0) { %>
      <p class="text-muted">Hali mavzu qo'shilmagan.</p>
    <% } %>
    <% materials.forEach(m => { %>
    <div class="card mb-2">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h5><%= m.title %></h5>
          <p class="mb-1"><%= m.description %></p>
          <% if (m.file_path) { %><a href="<%= m.file_path %>" target="_blank">📎 Faylni ko'rish</a><% } %>
        </div>
        <form method="POST" action="/teacher/materials/<%= m.id %>/delete" onsubmit="return confirm('O\'chirilsinmi?')">
          <button class="btn btn-danger btn-sm">O'chirish</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="content-form">
    <form method="POST" action="/teacher/materials" enctype="multipart/form-data" class="card p-3">
      <h5>Yangi mavzu qo'shish</h5>
      <input type="text" name="title" class="form-control mb-2" placeholder="Mavzu nomi" required>
      <textarea name="description" class="form-control mb-2" placeholder="Tavsif / ma'ruza matni" rows="4"></textarea>
      <input type="file" name="file" class="form-control mb-2">
      <button class="btn btn-primary w-100">Qo'shish</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
