<%- include('../partials/header') %>
<h3 class="mb-4">Topshiriqlarni boshqarish</h3>

<div class="content-columns">
  <div class="content-list">
    <% if (assignments.length === 0) { %>
      <p class="text-muted">Hali topshiriq yaratilmagan.</p>
    <% } %>
    <% assignments.forEach(a => { %>
    <div class="card mb-2">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h5><%= a.title %></h5>
          <p class="mb-1"><%= a.description %></p>
          <span class="badge <%= new Date(a.deadline) < new Date() ? 'bg-danger' : 'bg-secondary' %>">
            Muddat: <%= new Date(a.deadline).toLocaleString('uz-UZ') %>
          </span>
          <% if (a.file_path) { %>
            <div class="mt-1"><a href="<%= a.file_path %>" target="_blank">📎 Biriktirilgan faylni ko'rish</a></div>
          <% } %>
        </div>
        <div class="d-flex flex-column gap-2">
          <a href="/teacher/assignments/<%= a.id %>/submissions" class="btn btn-success btn-sm">Javoblarni ko'rish</a>
          <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editAssignmentModal<%= a.id %>">Tahrirlash</button>
          <form method="POST" action="/teacher/assignments/<%= a.id %>/delete" onsubmit="return confirm('O\'chirilsinmi?')">
            <button class="btn btn-danger btn-sm w-100">O'chirish</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="content-form">
    <form method="POST" action="/teacher/assignments" enctype="multipart/form-data" class="card p-3">
      <h5>Yangi topshiriq yaratish</h5>
      <input type="text" name="title" class="form-control mb-2" placeholder="Topshiriq nomi" required>
      <textarea name="description" class="form-control mb-2" placeholder="Vazifa tavsifi" rows="3"></textarea>
      <label class="form-label">Muddat (deadline)</label>
      <input type="datetime-local" name="deadline" class="form-control mb-2" required>
      <input type="file" name="file" class="form-control mb-2">
      <button class="btn btn-primary w-100">Yaratish</button>
    </form>
  </div>
</div>

<!-- Tahrirlash modallari - ro'yxatdan tashqarida, alohida joylashtirildi -->
<% assignments.forEach(a => { %>
<div class="modal fade" id="editAssignmentModal<%= a.id %>" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/teacher/assignments/<%= a.id %>/update" enctype="multipart/form-data" class="modal-content">
      <div class="modal-header"><h5>Topshiriqni tahrirlash</h5></div>
      <div class="modal-body">
        <label class="form-label">Topshiriq nomi</label>
        <input type="text" name="title" class="form-control mb-2" value="<%= a.title %>" required>

        <label class="form-label">Vazifa tavsifi</label>
        <textarea name="description" class="form-control mb-2" rows="3"><%= a.description %></textarea>

        <label class="form-label">Muddat (deadline)</label>
        <input type="datetime-local" name="deadline" class="form-control mb-2" value="<%= a.deadline %>" required>

        <label class="form-label">Fayl</label>
        <% if (a.file_path) { %>
          <div class="mb-2"><a href="<%= a.file_path %>" target="_blank">📎 Joriy fayl</a></div>
        <% } %>
        <input type="file" name="file" class="form-control">
        <div class="form-text">Yangi fayl tanlasangiz, eskisi almashtiriladi. Bo'sh qoldirsangiz, joriy fayl saqlanib qoladi.</div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Saqlash</button></div>
    </form>
  </div>
</div>
<% }) %>

<%- include('../partials/footer') %>
