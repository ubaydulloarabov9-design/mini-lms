<%- include('../partials/header') %>
<div class="container mt-5" style="max-width:420px;">
  <h3 class="mb-4">Talaba sifatida ro'yxatdan o'tish</h3>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="POST" action="/register">
    <input type="text" name="full_name" class="form-control mb-2" placeholder="To'liq ism" required>
    <input type="email" name="email" class="form-control mb-2" placeholder="Email" required>
    <input type="password" name="password" class="form-control mb-3" placeholder="Parol" required>
    <button class="btn btn-success w-100">Ro'yxatdan o'tish</button>
  </form>
  <p class="mt-3">Akkountingiz bormi? <a href="/login">Kirish</a></p>
</div>
<%- include('../partials/footer') %>
